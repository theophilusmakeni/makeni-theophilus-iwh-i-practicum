doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    main
      a(href='/update-cobj') Add/Update this table

      table
        thead
          tr
            th Name
            th Publisher
            th Price
        tbody
          each record in records
            tr
              td= record.properties.name
              td= record.properties.publisher
              td= record.properties.price
